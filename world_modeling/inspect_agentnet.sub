# inspect_agentnet.sub
#
# HTCondor submit file for inspecting the AgentNet Ubuntu 5K dataset.
# CPU-only batch job — no GPU needed.
# Downloads the JSONL from HuggingFace inside the job.
#
# Usage:
#   mkdir -p logs
#   condor_submit inspect_agentnet.sub
#
# Results will be in logs/inspect_<ClusterId>_0.out

universe                = container
container_image         = docker://ageppert01/chtc-cua:latest

executable              = /bin/bash
arguments               = run_inspect.sh

JobName                 = inspect

log                     = logs/inspect_agentnet/$(JobName)_$(Cluster)_$(Process).log
error                   = logs/inspect_agentnet/$(JobName)_$(Cluster)_$(Process).err
output                  = logs/inspect_agentnet/$(JobName)_$(Cluster)_$(Process).out

should_transfer_files   = YES
# inspect_agentnet.py is self-contained (does not import from core/).
transfer_input_files    = inspect_agentnet.py, run_inspect.sh, common.sh
when_to_transfer_output = ON_EXIT

request_cpus            = 1
request_memory          = 20GB
request_disk            = 20GB

queue