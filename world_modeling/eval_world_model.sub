# eval_world_model.sub
#
# HTCondor submit file for running world model evaluation.
# Requires GPU for inference.
#
# 4210 val examples at ~2s each = ~2.5 hours
#
# Usage:
#   mkdir -p logs
#   condor_submit eval_world_model.sub

universe                = container
container_image         = docker://ageppert01/chtc-cua:latest

executable              = /bin/bash
arguments               = run_eval.sh

JobName                 = eval_world_model/eval_wm

log                     = logs/$(JobName)_$(Cluster)_$(Process).log
error                   = logs/$(JobName)_$(Cluster)_$(Process).err
output                  = logs/$(JobName)_$(Cluster)_$(Process).out

should_transfer_files   = YES
# eval_world_model.py is self-contained (does not import from core/).
transfer_input_files    = eval_world_model.py, run_eval.sh, common.sh
transfer_output_files   = eval_predictions.jsonl, eval_stats.txt
when_to_transfer_output = ON_EXIT

request_gpus            = 1
+WantGPULab = true
+GPUJobLength = "short"
gpus_minimum_memory = 40GB
request_cpus            = 4
request_memory          = 40GB
request_disk            = 30GB

queue