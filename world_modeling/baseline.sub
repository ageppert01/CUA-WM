universe = container
container_image = docker://ageppert01/chtc-cua:latest

executable = /bin/bash
arguments = startup.sh baseline

JobName = opencua_api
log = logs/api_jobs/$(JobName)_$(Cluster)_$(Process).log
error = logs/api_jobs/$(JobName)_$(Cluster)_$(Process).err
output = logs/api_jobs/$(JobName)_$(Cluster)_$(Process).out

stream_output = True
stream_error = True

should_transfer_files = YES
# opencua_api.py is self-contained; no core/ transfer needed.
transfer_input_files = tunnel_key, startup.sh, common.sh
when_to_transfer_output = ON_EXIT

request_cpus = 1
request_memory = 40GB
request_disk = 40GB

+WantGPULab = true
+GPUJobLength = "short"
gpus_minimum_memory = 40GB
+RequireExclusiveGPU = true
request_gpus = 1

queue