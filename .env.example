# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
#   set -a; . ./.env; set +a

# HuggingFace token, required by run_preprocess.sh / run_train.sh / run_eval.sh
# to download AgentNet and to push the trained adapter and dataset to the Hub.
# Needs `write` scope only if you are uploading. https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Reverse SSH tunnel target, as user@host. The framework serves its API on a
# cluster execute node with no inbound routing, so it dials back out to a machine
# that OSWorld can reach. See docs/chtc-deployment.md.
CUA_WM_TUNNEL_HOST=user@your-host.example.com

# Private key used for that tunnel. Must sit next to the job scripts so HTCondor
# stages it with `transfer_input_files`. Default: tunnel_key
CUA_WM_TUNNEL_KEY=tunnel_key

# Port forwarded back through the tunnel, and the port the API binds. Default: 9009
CUA_WM_TUNNEL_PORT=9009
